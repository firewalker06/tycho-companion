; Engine configuration file.
; Edit through the Godot editor when possible.
config_version=5

[application]
config/name="Tycho Companion"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

[display/window]
size/viewport_width=1280
size/viewport_height=160
size/window_width_override=1280
size/window_height_override=160
size/resizable=false
size/borderless=true
transparent=true
stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0, 0, 0, 0)
